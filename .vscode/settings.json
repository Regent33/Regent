{
  // Kill the wall-of-squiggles line-length hints across docs (markdownlint),
  // the python voice server (ruff/pylint/flake8), and app/web markdown.
  // Repo discipline is file LENGTH (≤200 lines), not line width.
  // file-length-lint (pimzino) is OFF (owner call 2026-07-26). It flagged
  // generated output it had no business reading — `.next/` turbopack chunks,
  // the built voice server — and the repo's own ≤200-line discipline is
  // enforced by review, not by an editor squiggle on line 1 of every file.
  // The exclude list below is kept so re-enabling it stays one flag away.
  "fileLengthLint.enabled": false,
  // Belt and braces: if a future version ignores `enabled`, no real file in
  // this repo reaches six figures, so nothing will trip.
  "fileLengthLint.maxLines": 100000,
  "fileLengthLint.exclude": [
    "**/.next/**",
    "**/build/**",
    "**/.turbo/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/target/**",
    "**/*.lock",
    "**/bun.lock",
    "**/Cargo.lock",
    "**/package-lock.json",
    "**/*.lockb",
    "**/*.generated.ts",
    "**/CHANGELOG.md",
    "**/*.min.js",
    "**/*.svg",
    "**/__pycache__/**",
    "src/crates/paddle-ocr-rs/**",
    "src/crates/regent-orchustr-core/**",
    "tts-asr-local-models/**",
    "assets/**"
  ],
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "ruff.lineLength": 120,
  "pylint.args": ["--max-line-length=120", "--disable=C0301"],
  "flake8.args": ["--max-line-length=120"],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportLineTooLong": "none"
  }
}

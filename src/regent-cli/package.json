{
  "name": "regent-cli",
  "version": "0.1.4",
  "private": true,
  "description": "Regent's TypeScript/Ink terminal front-end — a thin JSON-RPC client to regent-deacon.",
  "type": "module",
  "bin": {
    "regent": "./dist/regent-cli"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "start": "bun run src/main.tsx",
    "test": "bun test",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "compile": "bun build src/main.tsx --compile --minify --define 'process.env.DEV=\"false\"' --outfile dist/regent-cli",
    "link": "bun run scripts/link.ts",
    "install-cli": "bun run compile && bun run link"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "pngjs": "^7.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^7.0.2"
  }
}
